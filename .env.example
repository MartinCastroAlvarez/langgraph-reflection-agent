# Copy to .env (never commit it). Every variable is optional.
REFLECTION_PROVIDER=ollama              # ollama | anthropic | fake
REFLECTION_MODEL=qwen3:4b               # claude-sonnet-5-5 for anthropic
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
REFLECTION_ALLOW_REMOTE_OLLAMA=
REFLECTION_TEMPERATURE=0
REFLECTION_THRESHOLD=8
REFLECTION_MAX_ITERATIONS=4
REFLECTION_MAX_ATTEMPTS=3
REFLECTION_MAX_QUERIES=3
REFLECTION_CANDIDATES=3
REFLECTION_MAX_DEPTH=3
REFLECTION_MAX_EXPANSIONS=4
REFLECTION_EXPLORATION=1.0
REFLECTION_CORPUS_DIR=                  # a folder of .md/.txt documents; default: the bundled ones
REFLECTION_SANDBOX_TIMEOUT=5
REFLECTION_FAKE_LATENCY=0
# Only for the optional Anthropic adapter (pip install ".[anthropic]"):
# ANTHROPIC_API_KEY=
